# --- core ---
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Rotating it signs everyone out, breaks signed media links, and resets the one-school-email rule
# (the email hashes are keyed from it, so a student could then verify a second account).
JWT_SECRET=dev-secret-change-me-please-32chars!!
DEV_ROUTES=1
DEV_TOKEN=                 # set on deployments; dev routes then need header x-dev-token
ATTEST_MODE=off            # off | log | enforce
FAKE_PROVIDERS=1           # 1 = all providers faked unless their key is set
RUN_WORKER=inline          # inline | off (prod runs worker as its own component)

# --- data ---
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=itp
TIGER_URL=postgres://postgres:postgres@localhost:5432/itp

# --- storage (RustFS (S3-compatible) locally, Spaces in prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=itp-media
S3_KEY=s3dev
S3_SECRET=s3dev12345
S3_FORCE_PATH_STYLE=1
CDN_BASE_URL=http://localhost:9000/itp-media

# --- apple (fill when the developer account exists) ---
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
APPLE_AUTH_KEY_ID=          # the one key for Sign in with Apple + APNs
APPLE_AUTH_PRIVATE_KEY=     # contents of that .p8, \n-escaped
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=     # contents of the .p8, \n-escaped
APNS_SANDBOX=0              # 1 for Xcode debug builds; TestFlight and App Store builds use production
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY=

# --- ai / 3rd party ---
GEMINI_API_KEY=
# Free-tier AI Studio keys: the newest Flash models are often overloaded (503); use gemini-3.5-flash-lite
# with GEMINI_BACKUP_MODEL=gemini-flash-lite-latest (both do tool calling and Maps grounding).
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_MAPS_KEY=
# C2PA Content Credentials signer (run scripts/make-c2pa-cert.sh; paste with literal \n for newlines)
C2PA_CERT_PEM=
C2PA_KEY_PEM=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The agent's iMessage number (E.164) the app puts in "Text the group"
PHOTON_AGENT_ADDRESS=
REALITY_DEFENDER_KEY=
RESEND_API_KEY=
EMAIL_FROM=
# Every user report is emailed here (default support@hermi.world)
REPORTS_EMAIL_TO=
# App Review sign-in: this address takes this 6-digit code instead of a school inbox, and its
# accounts get the campus "App Review" (no leaderboards, no matching).
# Set both or neither; empty is off.
REVIEW_EMAIL=
REVIEW_CODE=
# Optional: the team's own account (a user id). Each reviewer who verifies becomes its friend, so
# their Feed has real posts to try Report and Block on.
REVIEW_FRIEND_ID=
