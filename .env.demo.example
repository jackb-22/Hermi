# The backend on this laptop for the phones (scripts/demo-up.sh). Copy to .env.demo and fill in; never commit .env.demo.
# PUBLIC_BASE_URL is not set here: demo-up.sh sets it to the tunnel's URL.

# --- runtime: API and worker in one process ---
NODE_ENV=production
PORT=3000
RUN_WORKER=inline
AUTO_MIGRATE=1
ATTEST_MODE=log
FAKE_PROVIDERS=0
DEV_ROUTES=1
DEV_TOKEN=                # openssl rand -hex 32; the app sends it as x-dev-token for dev sign-in and simulated taps
JWT_SECRET=               # openssl rand -hex 32

# --- data: the production databases ---
MONGO_URI=
MONGO_DB=itp
TIGER_URL=

# --- media: RustFS from docker compose, served to phones by the API (no CDN) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=itp-demo
S3_KEY=s3dev
S3_SECRET=s3dev12345
S3_FORCE_PATH_STYLE=1
MEDIA_UPLOAD_MODE=api
MEDIA_DELIVERY=api

# --- providers ---
GEMINI_API_KEY=
BACKBOARD_API_KEY=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
PHOTON_AGENT_ADDRESS=
