# Production env for the Droplet (docs/DEPLOYMENT.md T2). Copy to deploy/.env, fill in, chmod 600.
# deploy/.env is gitignored: real values never go in this file or in git. See deploy/README.md.
#
# Lines with a value are the plan's fixed settings; leave them. Blank lines are yours to fill.
# One value per line, no inline comments. Wrap a value in single quotes if it has spaces or a $.
# Keep in step with apps/api/src/config.ts. [required] marks what production refuses to boot without.
# APPLE_AUTH_*, APNS_SANDBOX and REPORTS_EMAIL_TO come with the T6, T8 and T9 branches; config.ts here ignores them until then.
#
# Set by docker-compose.yml, not here: NODE_ENV=production, PORT=8080, TIGER_URL.
# Never set DEV_ROUTES or DEV_TOKEN: production refuses to boot with either.

# --- T2: runtime ---
PUBLIC_BASE_URL=https://api.hermi.world
FAKE_PROVIDERS=0
ATTEST_MODE=log
RUN_WORKER=inline
# Builds the Timescale schema and Mongo indexes at boot (idempotent).
AUTO_MIGRATE=1
# openssl rand -hex 32. Changing it signs everyone out. [required, and not the dev default]
JWT_SECRET=

# --- T2: Caddy (read by docker-compose.yml) ---
# Hostname Caddy gets a certificate for. Its DNS record must already point at the Droplet, DNS-only.
DOMAIN=api.hermi.world
# Let's Encrypt expiry notices go here.
ACME_EMAIL=

# --- Tiger: TimescaleDB container (T4) ---
# openssl rand -hex 24. Hex only, because it goes into a URL. Set it before the first boot:
# the data volume keeps the password it was created with.
TIMESCALE_PASSWORD=

# --- MongoDB Atlas (T4) ---
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Atlas Network Access must allow the Droplet's IP.
MONGO_URI=
MONGO_DB=hermi

# --- Cloudflare R2 (T5) ---
# https://<account id>.r2.cloudflarestorage.com [required]
S3_ENDPOINT=
S3_REGION=auto
# Create the bucket in the dashboard first: the API cannot create it on R2. Not checked at boot.
S3_BUCKET=
# R2 API token with Object Read & Write on that bucket [required: both]
S3_KEY=
S3_SECRET=
S3_FORCE_PATH_STYLE=1
MEDIA_UPLOAD_MODE=direct
# R2 has no per-object ACLs, so the API serves media at /media/<key>.
MEDIA_DELIVERY=api

# --- Apple (T1, T13) ---
# 10-character Team ID [required]
APPLE_TEAM_ID=
# The app's bundle ID: the Sign in with Apple audience and the WeatherKit service ID [required]
APPLE_BUNDLE_ID=
# The one .p8 shared by Sign in with Apple (code exchange and revoke) and APNs push: its key ID, and its
# contents on one line with newlines written as \n [required: both]
APPLE_AUTH_KEY_ID=
APPLE_AUTH_PRIVATE_KEY=
# Leave unset or 0: TestFlight and App Store builds use APNs production. Only Xcode debug builds need sandbox.
# APNS_SANDBOX=0
# Maps Server API key, for travel times. It needs APPLE_TEAM_ID and both of these; without them travel
# times use GOOGLE_MAPS_KEY, then a straight-line estimate.
APPLE_MAPS_KEY_ID=
# Contents of the .p8 on one line, newlines written as \n
APPLE_MAPS_PRIVATE_KEY=
# WeatherKit key, same format. Without it weather comes from Open-Meteo.
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY=

# --- Gemini (T13) ---
# Paid tier only: free-tier prompts can be read by human reviewers [required]
GEMINI_API_KEY=
# Pin the models by uncommenting and setting these. Do not leave them blank: a blank value is not the default.
# GEMINI_MODEL=
# GEMINI_BACKUP_MODEL=

# --- Resend (T6) ---
# [required]
RESEND_API_KEY=
# A sender on the verified Resend domain, e.g. Hermi <hello@hermi.world> [required]
EMAIL_FROM=
# Optional: user reports are emailed here. Defaults to support@hermi.world.
# REPORTS_EMAIL_TO=

# --- Photon (T13) ---
# Spectrum project from the Photon dashboard, for Text Hermi. Both blank turns Text Hermi off.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# The agent's iMessage number, E.164
PHOTON_AGENT_ADDRESS=

# --- Google Maps (T13) ---
# Restrict the key and set quotas in Google Cloud first. Used for place hours and as the travel-time fallback.
GOOGLE_MAPS_KEY=

# --- Left unset on purpose (plan: off for v1) ---
# C2PA_CERT_PEM, C2PA_KEY_PEM (a self-signed certificate shows as "untrusted"), REALITY_DEFENDER_KEY.
