{
  "name": "@itp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@contentauth/c2pa-node": "0.9.8",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/swagger": "^9.5.0",
    "@google/genai": "^2.24.0",
    "@itp/shared": "workspace:*",
    "@scalar/fastify-api-reference": "^1.36.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "jose": "^6.1.0",
    "mongodb": "^6.20.0",
    "node-app-attest": "^1.0.1",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "ulid": "^3.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0"
  }
}
