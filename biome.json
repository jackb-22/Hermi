{
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!apps/mobile",
      "!apps/api/src/data",
      "!apps/ios",
      "!**/.build",
      "!.ci-shots"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "rules": { "preset": "recommended", "style": { "noNonNullAssertion": "off" } } },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } }
}
